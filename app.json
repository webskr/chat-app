{
  "expo": {
    "name": "vegram",
    "slug": "vegram",
    "scheme": "myapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1014"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skr.vegram",
      "associatedDomains": ["applinks:myapp.com"]
    },
    "android": {
      "package": "com.skr.vegram",
      "backgroundColor": "#0b1014",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B5E20"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "myapp.com",
              "pathPrefix": "/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "softwareKeyboardLayoutMode": "resize",
      "navigationBar": {
        "backgroundColor": "#0b1014",
        "barStyle": "light-content"
      },
      "permissions": [
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Vegram to access your photos",
          "savePhotosPermission": "Allow Vegram to save photos",
          "isAccessMediaLocationEnabled": true,
          "videoPermission": "Allow Vegram to access your videos"
        }
      ],
      "expo-image-picker",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#000000"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25",
            "packagingOptions": {
              "pickFirst": [
                "lib/**/libcrypto.so",
                "lib/**/libssl.so",
                "lib/**/libjsi.so",
                "lib/**/libreactnative.so",
                "lib/**/libreact_nativeutils.so",
                "lib/**/libfbjni.so",
                "lib/**/libyoga.so",
                "lib/**/libfolly_runtime.so",
                "lib/**/libglog.so"
              ]
            }
          }
        }
      ],
      "expo-asset",
      "expo-video"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d221b2d2-27db-4837-97b5-e2403d708ddc"
      }
    },
    "owner": "web_skr"
  }
}
