{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "~/*": [
        "*"
      ]
    },
    "moduleResolution": "bundler",
    "jsx": "react-native",
    "types": [
      "react-native",
      "node"
    ]
  }
}